<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps a local ASR server resident so dictbench-ptt only records, POSTs and
  pastes. Replace YOUR_USER, the label and the serve command for your engine.

  Install:
    sed -e "s/YOUR_USER/$USER/g" com.example.dictbench-server.plist \
        > ~/Library/LaunchAgents/com.example.dictbench-server.plist
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.example.dictbench-server.plist
  Unload:
    launchctl bootout gui/$UID/com.example.dictbench-server
  Health:
    curl -sS http://127.0.0.1:50060/health

  If the agent never starts after a reboot, check
  System Settings → General → Login Items & Extensions → "Allow in the Background"
  and make sure the item is allowed; launchd silently skips disallowed agents.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.dictbench-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/nemo-speech" serve --asr-model parakeet-tdt --host 127.0.0.1 --port 50060 --no-ui</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/dictation-bench-server.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dictation-bench-server.log</string>
</dict>
</plist>
